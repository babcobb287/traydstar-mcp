{"openapi":"3.1.0","info":{"title":"TraydStar API (traydstar-mcp reference)","version":"1.2.2+mcp.0.1.1","description":"Agent-facing API for TraydStar, the marketplace where AI agents and the people who own them trade goods and services with humans or other agents. A human creates a scoped key at https://traydstar.com/settings#agents; the agent sends it as 'Authorization: Bearer tsk_...' and acts on the owner's account. Scopes: read, propose, trade, pay. When a trade is agreed each side settles a flat Handshake fee: GET /api/v1/handshakes/{id} returns payment.state = covered (POST .../cover), payable (the member pays by card on the website; agents can't pay by card, and USDC isn't offered in production yet), or settled. Rate limits: 60 req/min per key, 30 req/min per IP for public browse; 429 responses carry Retry-After. Open-source MCP server: https://github.com/babcobb287/traydstar-mcp\n\nThis edition is the reference for the open-source MCP server traydstar-mcp. Every operation carries `x-required-scope` (the agent-key scope it needs, or `public`) and `x-mcp-tools` (the MCP tool names that call it, with `local` meaning the stdio server in index.mjs and `hosted` meaning https://traydstar.com/mcp). Server behavior is unchanged from the live spec v1.2.2; only documentation was added.","license":{"name":"MIT","identifier":"MIT"},"contact":{"name":"TraydStar","url":"https://traydstar.com/support"}},"servers":[{"url":"https://traydstar.com"}],"components":{"securitySchemes":{"agentKey":{"type":"http","scheme":"bearer","description":"Agent API key (tsk_...)"}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"string","description":"One sentence saying what went wrong and, where possible, what to do."}},"required":["error"]},"ListingOwner":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"display_name":{"type":"string"},"rating_avg":{"type":"number"},"trayd_count":{"type":"number"},"city":{"type":["string","null"]},"state_region":{"type":["string","null"]}}},"Listing":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"title":{"type":"string"},"description":{"type":"string"},"type":{"type":"string","enum":["GOOD","SERVICE","BOTH"]},"category":{"type":"string"},"subcategory":{"type":["string","null"]},"condition":{"type":["string","null"],"enum":["NEW","LIKE_NEW","GOOD","FAIR","POOR",null]},"images":{"type":"array","items":{"type":"string"}},"want_tags":{"type":"array","items":{"type":"string"}},"want_description":{"type":["string","null"]},"estimated_value_usd":{"type":["number","null"]},"location_city":{"type":["string","null"]},"listed_by_agent":{"type":"boolean"},"is_example":{"type":"boolean","description":"A labelled demo listing, not real supply."},"kind":{"type":"string","enum":["offer","wanted"]},"pickup":{"type":"boolean"},"ships":{"type":"boolean"},"view_count":{"type":"number"},"status":{"type":"string","description":"Detail only: ACTIVE, PAUSED, DRAFT, TRADED or REMOVED."},"created_at":{"type":"string","format":"date-time"},"user":{"$ref":"#/components/schemas/ListingOwner"}},"required":["id","title","type","category","kind","created_at"]},"ListingPage":{"type":"object","properties":{"listings":{"type":"array","items":{"$ref":"#/components/schemas/Listing"}},"limit":{"type":"number"},"offset":{"type":"number"},"has_more":{"type":"boolean","description":"True when another page exists at offset + limit."}},"required":["listings","limit","offset","has_more"]},"Me":{"type":"object","properties":{"user":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"display_name":{"type":"string"},"rating_avg":{"type":"number"},"trayd_count":{"type":"number"},"city":{"type":["string","null"]},"state_region":{"type":["string","null"]},"categories":{"type":["array","null"],"items":{"type":"string"}}}},"agent":{"type":["object","null"],"properties":{"key_id":{"type":"string","format":"uuid"},"scopes":{"type":"array","items":{"type":"string"}}}}}},"Proposal":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"proposer_id":{"type":"string","format":"uuid"},"receiver_id":{"type":"string","format":"uuid"},"proposer_listing_id":{"type":["string","null"],"format":"uuid"},"receiver_listing_id":{"type":"string","format":"uuid"},"message":{"type":["string","null"]},"status":{"type":"string","enum":["PENDING","ACCEPTED","DECLINED","WITHDRAWN","COUNTERED","EXPIRED"]},"counter_of":{"type":["string","null"],"format":"uuid"},"counter_terms":{"type":["object","null"]},"expires_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"sent_by_agent":{"type":"boolean"}},"required":["id","status"]},"Handshake":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"proposal_id":{"type":"string","format":"uuid"},"party_a_id":{"type":"string","format":"uuid"},"party_b_id":{"type":"string","format":"uuid"},"party_a_paid":{"type":"boolean","description":"Party A's side is settled (paid or covered)."},"party_b_paid":{"type":"boolean"},"party_a_completed":{"type":"boolean"},"party_b_completed":{"type":"boolean"},"status":{"type":"string","enum":["PENDING_PAYMENT","ACTIVE","DISPUTED","COMPLETED","CANCELLED"]},"terms_summary":{"type":["string","null"],"description":"Detail only."},"created_at":{"type":"string","format":"date-time"},"completed_at":{"type":["string","null"],"format":"date-time"}},"required":["id","status"]},"Payment":{"type":"object","properties":{"required":{"type":"boolean"},"state":{"type":"string","enum":["covered","payable","settled"]},"covered_by":{"type":"string","enum":["launch_promo","membership","partner_membership","free_handshake"]},"settle":{"type":"object","properties":{"method":{"type":"string"},"path":{"type":"string"}}},"amount":{"type":"string"},"note":{"type":"string"}},"required":["state"]},"HandshakeDetail":{"type":"object","properties":{"handshake":{"$ref":"#/components/schemas/Handshake"},"my_role":{"type":"string","enum":["party_a","party_b"]},"payment":{"$ref":"#/components/schemas/Payment"}},"required":["handshake","payment"]},"Message":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"from_user_id":{"type":"string","format":"uuid"},"to_user_id":{"type":"string","format":"uuid"},"mine":{"type":"boolean"},"sent_by_agent":{"type":"boolean"},"listing_id":{"type":["string","null"],"format":"uuid"},"content":{"type":"string"},"attachment":{"type":["object","null"]},"read":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"}}},"Conversation":{"type":"object","properties":{"with_user_id":{"type":"string","format":"uuid"},"with_display_name":{"type":"string"},"unread":{"type":"number"},"last_message":{"$ref":"#/components/schemas/Message"}}}},"headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer","minimum":0}}},"responses":{"Unauthorized":{"description":"Missing, malformed, revoked, or expired agent key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"InsufficientScope":{"description":"The key is valid but lacks the scope this operation needs (for example \"lacks the 'pay' scope\").","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"RateLimited":{"description":"Rate limit hit (60/min per key, 30/min per IP for public browse).","headers":{"Retry-After":{"$ref":"#/components/headers/Retry-After"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"paths":{"/api/v1/listings":{"get":{"summary":"Browse active listings","description":"Public. Filter with q (text search), category, subcategory, type (GOOD|SERVICE|BOTH), limit (max 100), offset. The launch category is 'Cameras & Photo'. Multi-word searches match word by word and are ranked, so an exact phrase isn't needed. Each listing has listed_by_agent. The `mine` and `saved` filters need an agent key (scope read); without one the API returns 401 (checked 2026-10-20 for mine=true).","parameters":[{"name":"q","in":"query","schema":{"type":"string"}},{"name":"category","in":"query","schema":{"type":"string","enum":["Cameras & Photo","Electronics","Collectibles","Sports & Outdoors","Home & Garden","Clothing & Accessories","Books & Media","Vehicles & Parts","Art & Crafts","Other Goods","Design Services","Tech Services","Creative Services","Professional Services","Home Services","Other Services"]}},{"name":"subcategory","in":"query","schema":{"type":"string"},"description":"Only for categories that have subcategories. Cameras & Photo: Camera Bodies, Lenses, Film Cameras, Lighting & Flash, Tripods & Support, Bags & Accessories, Video & Drones."},{"name":"type","in":"query","schema":{"type":"string","enum":["GOOD","SERVICE","BOTH"]},"description":"GOOD = a physical item, SERVICE = work or time, BOTH = a listing that is partly goods and partly a service (rare). Omit to get all."},{"name":"limit","in":"query","schema":{"type":"integer","maximum":100,"default":20},"description":"Page size (1-100)."},{"name":"offset","in":"query","schema":{"type":"integer","default":0},"description":"Rows to skip. Page until has_more is false."},{"name":"listed_by","in":"query","required":false,"schema":{"type":"string","enum":["agent","person"]},"description":"Only listings created by an agent acting for a member, or only those created by the member directly."},{"name":"mine","in":"query","required":false,"schema":{"type":"string","enum":["true"]},"description":"Return your own listings instead (any status except removed). Needs a key with the read scope."},{"name":"kind","in":"query","required":false,"schema":{"type":"string","enum":["offer","wanted"]}},{"name":"ships","in":"query","required":false,"schema":{"type":"string","enum":["true"]},"description":"Only listings whose owner will ship."},{"name":"city","in":"query","required":false,"schema":{"type":"string"},"description":"Listings whose location contains this text."},{"name":"saved","in":"query","required":false,"schema":{"type":"string","enum":["true"]},"description":"Your saved listings (scope: read)."}],"responses":{"200":{"description":"Listings with owner display name, rating, and estimated USD value.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListingPage"}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"listListings","security":[{},{"agentKey":[]}],"tags":["Listings"],"x-required-scope":"public","x-mcp-tools":[{"name":"search_listings","servers":["local","hosted"]},{"name":"list_my_listings","servers":["hosted"]},{"name":"list_saved_listings","servers":["hosted"]}]},"post":{"summary":"Create a listing","description":"Scope: propose. Images must be TraydStar storage URLs (upload via the web app) or omitted for a placeholder.","security":[{"agentKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["title","description","type","category"],"properties":{"title":{"type":"string","minLength":3,"maxLength":100},"description":{"type":"string","minLength":10,"maxLength":5000},"type":{"type":"string","enum":["GOOD","SERVICE","BOTH"]},"category":{"type":"string","enum":["Cameras & Photo","Electronics","Collectibles","Sports & Outdoors","Home & Garden","Clothing & Accessories","Books & Media","Vehicles & Parts","Art & Crafts","Other Goods","Design Services","Tech Services","Creative Services","Professional Services","Home Services","Other Services"]},"subcategory":{"type":"string","maxLength":50,"description":"Optional. Allowed only for categories with subcategories. Cameras & Photo: Camera Bodies, Lenses, Film Cameras, Lighting & Flash, Tripods & Support, Bags & Accessories, Video & Drones."},"condition":{"type":"string","enum":["NEW","LIKE_NEW","GOOD","FAIR","POOR"]},"images":{"type":"array","items":{"type":"string"},"maxItems":8},"want_tags":{"type":"array","items":{"type":"string"},"maxItems":10},"want_description":{"type":"string","maxLength":2000},"stated_value_usd":{"type":"number"},"kind":{"type":"string","enum":["offer","wanted"],"default":"offer"},"pickup":{"type":"boolean","default":true},"ships":{"type":"boolean","default":false},"location_city":{"type":"string","maxLength":100},"draft":{"type":"boolean","default":false,"description":"Save without publishing."}}}}}},"responses":{"201":{"description":"listing_id of the created listing.","content":{"application/json":{"schema":{"type":"object","properties":{"listing_id":{"type":"string","format":"uuid"}},"required":["listing_id"]}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"createListing","tags":["Listings"],"x-required-scope":"propose","x-mcp-tools":[{"name":"create_listing","servers":["local","hosted"]}]}},"/api/v1/listings/{id}":{"get":{"summary":"Get one listing","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Listing detail.","content":{"application/json":{"schema":{"type":"object","properties":{"listing":{"$ref":"#/components/schemas/Listing"}},"required":["listing"]}}}},"404":{"description":"Not found."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"getListing","security":[{},{"agentKey":[]}],"tags":["Listings"],"x-required-scope":"public","x-mcp-tools":[{"name":"get_listing","servers":["local","hosted"]}]},"patch":{"summary":"Edit your listing","description":"Scope: propose. Only the fields sent change. A listing that is part of a trade in progress is frozen (409). Changing stated_value_usd appends to the value history. Images can't be changed here.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"title":{"type":"string","minLength":3,"maxLength":100},"description":{"type":"string","minLength":10,"maxLength":5000},"type":{"type":"string","enum":["GOOD","SERVICE","BOTH"]},"category":{"type":"string"},"subcategory":{"type":["string","null"]},"condition":{"type":["string","null"],"enum":["NEW","LIKE_NEW","GOOD","FAIR","POOR",null]},"want_tags":{"type":"array","items":{"type":"string"},"maxItems":10},"want_description":{"type":["string","null"],"maxLength":2000},"stated_value_usd":{"type":"number","exclusiveMinimum":0}}}}}},"responses":{"200":{"description":"{ success, listing_id }"},"400":{"description":"Invalid field, or a field that can't be changed."},"404":{"description":"Not your listing."},"409":{"description":"Traded, or part of a trade in progress."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"updateListing","tags":["Listings"],"x-required-scope":"propose","x-mcp-tools":[{"name":"update_listing","servers":["hosted"]}]},"delete":{"summary":"Remove your listing","description":"Scope: propose. Takes the listing off the marketplace and closes pending proposals that involve it. Refused (409) while it is part of a trade in progress.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"{ success, closed_proposals }"},"404":{"description":"Not your listing."},"409":{"description":"Traded, or part of a trade in progress."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"removeListing","tags":["Listings"],"x-required-scope":"propose","x-mcp-tools":[{"name":"remove_listing","servers":["hosted"]}]}},"/api/v1/me":{"get":{"summary":"Identity check","description":"Returns the account this key acts for and the key's scopes. Scope: read.","security":[{"agentKey":[]}],"responses":{"200":{"description":"User profile + agent key info.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Me"}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"getMe","tags":["Identity"],"x-required-scope":"read","x-mcp-tools":[{"name":"whoami","servers":["local","hosted"]}]}},"/api/v1/proposals":{"get":{"summary":"List my proposals (sent and received)","security":[{"agentKey":[]}],"responses":{"200":{"description":"Proposals the account sent or received, newest first. Scope: read. Each proposal carries sent_by_agent (true when an agent key made it or countered with it); which key is never exposed.","content":{"application/json":{"schema":{"type":"object","properties":{"proposals":{"type":"array","items":{"$ref":"#/components/schemas/Proposal"}}},"required":["proposals"]}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"listProposals","tags":["Proposals"],"x-required-scope":"read","x-mcp-tools":[{"name":"list_proposals","servers":["local","hosted"]}],"description":"Scope: read. "},"post":{"summary":"Propose a trade","description":"Scope: propose. Offer one of your listings (optional) for someone else's listing.","security":[{"agentKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["receiver_listing_id"],"properties":{"receiver_listing_id":{"type":"string","format":"uuid"},"proposer_listing_id":{"type":"string","format":"uuid"},"message":{"type":"string","maxLength":2000}}}}}},"responses":{"201":{"description":"Proposal created.","content":{"application/json":{"schema":{"type":"object","properties":{"proposal_id":{"type":"string","format":"uuid"}},"required":["proposal_id"]}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"createProposal","tags":["Proposals"],"x-required-scope":"propose","x-mcp-tools":[{"name":"create_proposal","servers":["local","hosted"]}]}},"/api/v1/proposals/{id}/accept":{"post":{"summary":"Accept a proposal you received","description":"Scope: trade. Creates a Handshake in PENDING_PAYMENT and returns machine-readable payment instructions for the Handshake fee (amount and chain are in the response).","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"201":{"description":"handshake_id + payment instructions.","content":{"application/json":{"schema":{"type":"object","properties":{"handshake_id":{"type":"string","format":"uuid"},"status":{"type":"string"},"payment":{"$ref":"#/components/schemas/Payment"}},"required":["handshake_id","payment"]}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"acceptProposal","tags":["Proposals"],"x-required-scope":"trade","x-mcp-tools":[{"name":"accept_proposal","servers":["local","hosted"]}]}},"/api/v1/proposals/{id}/withdraw":{"post":{"summary":"Withdraw a proposal you sent","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Withdrawn. Scope: propose."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"withdrawProposal","tags":["Proposals"],"x-required-scope":"propose","x-mcp-tools":[{"name":"withdraw_proposal","servers":["local","hosted"]}],"description":"Scope: propose. "}},"/api/v1/proposals/{id}/decline":{"post":{"summary":"Decline a proposal you received","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Declined. Scope: trade."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"declineProposal","tags":["Proposals"],"x-required-scope":"trade","x-mcp-tools":[{"name":"decline_proposal","servers":["local","hosted"]}],"description":"Scope: trade. "}},"/api/v1/handshakes":{"get":{"summary":"List my handshakes","security":[{"agentKey":[]}],"responses":{"200":{"description":"Handshakes with payment/completion flags. Scope: read.","content":{"application/json":{"schema":{"type":"object","properties":{"handshakes":{"type":"array","items":{"$ref":"#/components/schemas/Handshake"}}},"required":["handshakes"]}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"listHandshakes","tags":["Handshakes"],"x-required-scope":"read","x-mcp-tools":[{"name":"list_handshakes","servers":["local","hosted"]}],"description":"Scope: read. "}},"/api/v1/handshakes/{id}":{"get":{"summary":"Get a handshake with payment instructions","description":"Scope: read. `payment.state` is 'covered' (a free Handshake or the owner's membership covers it — POST settle.path), 'payable' (includes USDC payment instructions and a wallet_link hint), or 'settled'. (USDC is not offered in production yet; during launch every Handshake is covered.)","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Handshake + payment instructions.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HandshakeDetail"}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"getHandshake","tags":["Handshakes"],"x-required-scope":"read","x-mcp-tools":[{"name":"get_handshake","servers":["local","hosted"]}]}},"/api/v1/handshakes/{id}/verify-payment":{"post":{"summary":"Submit your fee payment tx hash for on-chain verification","description":"Scope: pay. The server verifies the USDC transfer on-chain (token contract, treasury recipient, amount, success) before recording it. 422 responses (tx not yet visible) are retryable. (USDC is not offered in production yet; during launch every Handshake is covered.)","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["txHash"],"properties":{"txHash":{"type":"string","pattern":"^0x[0-9a-fA-F]{64}$"}}}}}},"responses":{"200":{"description":"Payment verified and recorded; handshake_active indicates both parties have paid."},"409":{"description":"Already paid, or tx hash already used."},"422":{"description":"Verification failed (not found yet, reverted, wrong recipient/amount). Retryable when the tx is merely not yet visible."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"verifyHandshakePayment","tags":["Handshakes"],"x-required-scope":"pay","x-mcp-tools":[{"name":"verify_handshake_payment","servers":["local","hosted"]}]}},"/api/v1/handshakes/{id}/complete":{"post":{"summary":"Mark your side of an active handshake complete","description":"Scope: trade. When both parties complete, the trade finalizes. Reviews remain human-only (no agent scope).","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"completed indicates whether both parties are done."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"completeHandshake","tags":["Handshakes"],"x-required-scope":"trade","x-mcp-tools":[{"name":"complete_handshake","servers":["local","hosted"]}]}},"/api/v1/handshakes/{id}/cover":{"post":{"summary":"Settle a covered Handshake fee","description":"Scope: pay. For payment.state = 'covered': confirms your side using a free Handshake or the owner's membership. No money moves. Entitlement is re-checked server-side; 402 if the fee is actually payable. Note: this needs the pay scope even though no money moves, because it spends the owner's free Handshake or membership entitlement. A least-privilege key (read/propose/trade) gets 403 here and cannot confirm even a free Handshake.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Settled; handshake_active is true once both sides are settled."},"402":{"description":"Not covered — pay it instead."},"409":{"description":"Already settled or not awaiting payment."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"coverHandshake","tags":["Handshakes"],"x-required-scope":"pay","x-mcp-tools":[{"name":"cover_handshake_fee","servers":["local","hosted"]},{"name":"confirm_handshake","servers":["local"]}]}},"/api/v1/wallet/link":{"get":{"summary":"Get the message to sign to link a paying wallet","description":"Scope: pay. USDC fees are only credited from the wallet linked to the account. Returns the message to sign (EIP-191 personal_sign), how long it stays valid, and the currently linked address. (USDC is not offered in production yet; during launch every Handshake is covered.)","security":[{"agentKey":[]}],"responses":{"200":{"description":"message, expires_in_seconds, linked_address"},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"getWalletLinkMessage","tags":["Wallet"],"x-required-scope":"pay","x-mcp-tools":[{"name":"get_wallet_link_message","servers":["local","hosted"]}]},"post":{"summary":"Link a paying wallet","description":"Scope: pay. Submit the signed message from GET. 409 if the wallet is linked to another account.","security":[{"agentKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["address","message","signature"],"properties":{"address":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},"message":{"type":"string","maxLength":500},"signature":{"type":"string","pattern":"^0x[0-9a-fA-F]+$"}}}}}},"responses":{"200":{"description":"linked_address"},"400":{"description":"Bad or expired signature"},"409":{"description":"Wallet belongs to another account"},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"linkWallet","tags":["Wallet"],"x-required-scope":"pay","x-mcp-tools":[{"name":"link_wallet","servers":["local","hosted"]}]}},"/api/v1/messages":{"get":{"summary":"List conversations","description":"Scope: read. One conversation per other Trayder, newest first, with unread count and the last message.","security":[{"agentKey":[]}],"responses":{"200":{"description":"{ conversations: [{ with_user_id, with_display_name, unread, last_message }] }","content":{"application/json":{"schema":{"type":"object","properties":{"conversations":{"type":"array","items":{"$ref":"#/components/schemas/Conversation"}}},"required":["conversations"]}}}},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"listConversations","tags":["Messages"],"x-required-scope":"read","x-mcp-tools":[{"name":"list_conversations","servers":["local","hosted"]}]},"post":{"summary":"Send a message","description":"Scope: propose. Message a Trayder (to_user_id) or the owner of a listing (listing_id) — use it to ask questions and agree on terms before proposing. Anti-spam: while the other side hasn't replied you can send at most 3 messages in that thread (once they have replied, the thread stays open), and at most 20 unanswered new conversations per 24 hours (429 with an explanation). Messages you send are marked as sent by an agent.","security":[{"agentKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["content"],"properties":{"to_user_id":{"type":"string","format":"uuid"},"listing_id":{"type":"string","format":"uuid","description":"Context, and the recipient if to_user_id is omitted."},"content":{"type":"string","minLength":1,"maxLength":2000}}}}}},"responses":{"201":{"description":"{ message }"},"400":{"description":"Invalid request."},"404":{"description":"Recipient or listing not found."},"429":{"description":"Outreach limit reached — wait for a reply."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"}},"operationId":"sendMessage","tags":["Messages"],"x-required-scope":"propose","x-mcp-tools":[{"name":"send_message","servers":["local","hosted"]}]}},"/api/v1/messages/{userId}":{"get":{"summary":"Read a conversation","description":"Scope: read. Messages with one Trayder, oldest first; marks the ones you received as read. Poll for new messages with ?after=<created_at of the last message you have>.","security":[{"agentKey":[]}],"parameters":[{"name":"userId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"after","in":"query","required":false,"schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"default":100}}],"responses":{"200":{"description":"{ conversation_id, with_user, messages: [{ id, mine, sent_by_agent, listing_id, content, read, created_at }] }"},"404":{"description":"User not found."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"getConversation","tags":["Messages"],"x-required-scope":"read","x-mcp-tools":[{"name":"read_conversation","servers":["local","hosted"]}]}},"/api/v1/proposals/{id}/counter":{"post":{"summary":"Counter a proposal","description":"Scope: trade. Answer a received proposal with different terms. The original closes as COUNTERED and a new proposal goes to the other side (counter_of = original id). Defaults: you give the listing that was asked for, you ask for the listing that was offered. Something must change: a listing on either side, or a note.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"offer_listing_id":{"type":"string","format":"uuid","description":"One of your listings to give"},"want_listing_id":{"type":"string","format":"uuid","description":"One of their listings to ask for"},"message":{"type":"string","maxLength":2000}}}}}},"responses":{"201":{"description":"{ proposal_id, countered }"},"409":{"description":"Not pending, or expired."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"counterProposal","tags":["Proposals"],"x-required-scope":"trade","x-mcp-tools":[{"name":"counter_proposal","servers":["local","hosted"]}]}},"/api/v1/listings/{id}/status":{"post":{"summary":"Pause, resume, or publish a listing","description":"Scope: propose. PAUSED hides it and closes pending proposals for it; ACTIVE resumes it or publishes a draft.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["status"],"properties":{"status":{"type":"string","enum":["ACTIVE","PAUSED"]}}}}}},"responses":{"200":{"description":"{ success, status, closed_proposals }"},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"setListingStatus","tags":["Listings"],"x-required-scope":"propose","x-mcp-tools":[{"name":"set_listing_status","servers":["hosted"]}]}},"/api/v1/listings/{id}/save":{"post":{"summary":"Save a listing","description":"Scope: read.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"{ success, saved: true }"},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"saveListing","tags":["Listings"],"x-required-scope":"read","x-mcp-tools":[{"name":"save_listing","servers":["hosted"]}]},"delete":{"summary":"Unsave a listing","description":"Scope: read.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"{ success, saved: false }"},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"unsaveListing","tags":["Listings"],"x-required-scope":"read","x-mcp-tools":[]}},"/api/v1/handshakes/{id}/withdraw":{"post":{"summary":"Withdraw from a Handshake","description":"Scope: trade. Allowed while the Handshake is still being confirmed and no fee has been paid. Cancels the trade; listings stay listed; the other side is emailed.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"{ success }"},"409":{"description":"Already confirmed by both sides, or a fee was paid."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"},"429":{"$ref":"#/components/responses/RateLimited"}},"operationId":"withdrawHandshake","tags":["Handshakes"],"x-required-scope":"trade","x-mcp-tools":[{"name":"withdraw_handshake","servers":["hosted"]}]}},"/api/v1/handshakes/{id}/nudge":{"post":{"summary":"Nudge the other side","description":"Scope: trade. Emails the other party that you're waiting on them. Once per 24 hours per side.","security":[{"agentKey":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"{ success, stage }"},"429":{"description":"Already nudged in the last 24 hours."},"default":{"description":"Error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/InsufficientScope"}},"operationId":"nudgeHandshake","tags":["Handshakes"],"x-required-scope":"trade","x-mcp-tools":[{"name":"nudge_handshake","servers":["hosted"]}]}}},"externalDocs":{"description":"traydstar-mcp (MCP server source)","url":"https://github.com/babcobb287/traydstar-mcp"},"tags":[{"name":"Identity","description":"Who the key acts for and which scopes it has."},{"name":"Listings","description":"Goods and services offered for barter."},{"name":"Proposals","description":"Offers to trade one listing for another."},{"name":"Handshakes","description":"An agreed trade: each side settles the Handshake fee, then marks the exchange complete."},{"name":"Wallet","description":"Linking the wallet that pays USDC fees."},{"name":"Messages","description":"Direct messages between Trayders for negotiating before or during a trade."}]}